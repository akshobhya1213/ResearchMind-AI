# Copy to .env (never commit .env). Only GEMINI_API_KEY is required for LLM features.
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CLASSIFIER_MODEL=allenai-specter
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ALLOW_FALLBACK_MODELS=true
DATA_DIR=./data
CHUNK_SIZE=220
CHUNK_OVERLAP=40
TOP_K=5
MIN_VECTOR_SCORE=0.30
MIN_RERANK_SCORE=0.05
PRELOAD_MODELS=false
OCR_FALLBACK=true
CLASSIFY_ON_UPLOAD=true
LOG_LEVEL=INFO
